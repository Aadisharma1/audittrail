{
  "name": "audittrail",
  "description": "Centralized risk & audit logging microservice: FastAPI + SQLite, configurable risk rules, JWT-protected endpoints, Next.js dashboard",
  "language": "python",
  "checks": [
    {
      "name": "unit_tests",
      "cmd": "python -m pytest tests -q",
      "timeout_sec": 900
    },
    {
      "name": "smoke_test",
      "cmd": "python scripts/smoke_test.py",
      "timeout_sec": 600
    },
    {
      "name": "frontend_build",
      "cmd": "npm run build",
      "cwd": "frontend",
      "skip_if_cmd_missing": "npm",
      "timeout_sec": 900
    }
  ],
  "docker": {
    "enabled": true
  }
}
